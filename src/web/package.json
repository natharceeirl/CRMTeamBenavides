{
  "name": "crm-team-benavides-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint --max-warnings=0 src",
    "tipos:generar": "dotnet run -c Release --project ../../tools/GeneradorTipos -- src/api/generado/contratos.ts",
    "tipos:verificar": "dotnet run -c Release --project ../../tools/GeneradorTipos -- src/api/generado/contratos.ts --verificar",
    "verificar": "npm run tipos:verificar && tsc -b && oxlint --max-warnings=0 src && vitest run"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tanstack/react-query": "^5.103.0",
    "antd": "^6.6.4",
    "dayjs": "^1.11.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
