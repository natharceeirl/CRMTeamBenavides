<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Solo en depuración: la API local corre en http, y Android bloquea el
         tráfico sin cifrar desde Android 9. En producción la API irá por https
         y esta excepción no se aplica, porque este manifiesto no se compila. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
