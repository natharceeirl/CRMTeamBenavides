# Caddy recibe el HTTPS, sirve la web y reenvía /api a la API con X-Forwarded-For y
# X-Forwarded-Proto. Para DOMINIO pide solo el certificado a Let's Encrypt (el DNS
# tiene que apuntar al servidor y los puertos 80 y 443 estar abiertos). Con
# DOMINIO=localhost usa un certificado propio, para ensayar en una PC.

{$DOMINIO} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		# Las rutas de la web (/ordenes/123) las resuelve React: todas cargan index.html.
		try_files {path} /index.html
		file_server
	}

	header {
		# 0 al ensayar en una PC: si no, el navegador exigiría HTTPS en localhost por un año.
		Strict-Transport-Security "max-age={$HSTS_SEGUNDOS:0}"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Los archivos de /assets llevan un hash en el nombre: se guardan un año. El resto
	# (index.html) se vuelve a pedir siempre, para que una versión nueva llegue al recargar.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@paginas not path /assets/* /api/*
	header @paginas Cache-Control "no-cache"
}
