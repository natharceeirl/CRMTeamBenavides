# Plantilla de entorno exclusiva para QA (/opt/crm-team-benavides-qa/despliegue/.env).
# Copiar como .env en el servidor QA y reemplazar TODOS los marcadores REEMPLAZAR_CON_*.
# El archivo .env real NUNCA se sube al repositorio.
# NUNCA reutilizar contraseñas, llaves JWT ni tokens del entorno de producción.
# El script actualizar-qa.sh y la API al arrancar rechazan cualquier marcador REEMPLAZAR_CON_*.

# ---------------------------------------------------------------------------
# 0. Aislamiento obligatorio de Docker Compose en QA
# ---------------------------------------------------------------------------
# Impide que un comando «docker compose» ejecutado sin «-f» o «-p» en esta carpeta
# seleccione accidentalmente docker-compose.yml o el proyecto de producción.
COMPOSE_FILE=docker-compose.qa.yml
COMPOSE_PROJECT_NAME=crm-team-benavides-qa

# ---------------------------------------------------------------------------
# 1. Caddy y dominio QA
# ---------------------------------------------------------------------------
# Subdominio exclusivo de QA con registro DNS A apuntando a la IP del servidor QA.
# Nunca usar el dominio de producción. Para ensayos locales en PC: localhost.
DOMINIO=REEMPLAZAR_CON_DOMINIO_QA

# En QA se deja en 0 inicialmente mientras se valida el certificado TLS; luego puede subirse.
HSTS_SEGUNDOS=0

# Puertos públicos del servidor QA independiente (Meta Cloud API exige 443 estándar).
PUERTO_HTTP=80
PUERTO_HTTPS=443

# ---------------------------------------------------------------------------
# 2. PostgreSQL 18 exclusivo de QA
# ---------------------------------------------------------------------------
# Deben ser distintos de producción (crm_teambenavides / crm).
POSTGRES_DB=crm_teambenavides_qa
POSTGRES_USER=crm_qa
# Generar en el servidor QA con: openssl rand -hex 32
POSTGRES_PASSWORD=REEMPLAZAR_CON_CLAVE_DB_QA_HEX_32

# ---------------------------------------------------------------------------
# 3. API y seguridad JWT exclusiva de QA
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Staging

# Firma de tokens JWT exclusiva de QA (mínimo 32 caracteres, distinto de producción).
# Generar en el servidor QA con: openssl rand -hex 48
JWT_SECRET_KEY=REEMPLAZAR_CON_CLAVE_JWT_QA_HEX_48

# ---------------------------------------------------------------------------
# 4. Red Docker interna exclusiva de QA
# ---------------------------------------------------------------------------
# Subred aislada de producción (producción usa 172.30.0.0/24).
RED_INTERNA_QA=172.31.0.0/24

# ---------------------------------------------------------------------------
# 5. Respaldos exclusivos de QA
# ---------------------------------------------------------------------------
# Copia diaria en despliegue/respaldos-qa/ con retención de 7 días.
HORA_RESPALDO=03:00
RETENCION_DIAS=7

# ---------------------------------------------------------------------------
# 6. Servicios externos (deshabilitados / modo seguro en QA)
# ---------------------------------------------------------------------------
# Avisos push: en QA se mantienen en Registro (solo log, sin envíos Firebase reales).
NOTIFICACIONES_PROVEEDOR=Registro
FIREBASE_CREDENCIALES_JSON=

# Consulta DNI/RUC (Decolecta): vacío en QA para ingresar nombres manualmente sin consumir cuota.
DECOLECTA_TOKEN=

# Integración Yamaha Motor del Perú (v3): deshabilitada en QA.
YAMAHA_ENABLED=false
YAMAHA_CODIGO_PUNTO_VENTA=
YAMAHA_NOMBRE_COMERCIAL_PUNTO_VENTA=Team Benavides QA
YAMAHA_TIPO_PUNTO_VENTA=3S
YAMAHA_VENTAS_ENDPOINT_URL=
YAMAHA_STOCK_ENDPOINT_URL=
YAMAHA_SERVICIO_TECNICO_ENDPOINT_URL=
YAMAHA_FUNCTION_KEY=
YAMAHA_VENTAS_FUNCTION_KEY=
YAMAHA_STOCK_FUNCTION_KEY=
YAMAHA_SERVICIO_TECNICO_FUNCTION_KEY=
YAMAHA_HORA_CIERRE_STOCK_PERU=22:00
YAMAHA_HORA_LIMITE_RECUPERACION_STOCK_PERU=08:00
YAMAHA_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# 7. WhatsApp Business Cloud API (deshabilitado y Mock por defecto en QA)
# ---------------------------------------------------------------------------
# NO cambiar a true ni a Meta sin autorización expresa de Santiago y credenciales de Sandbox.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=Mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# 8. WhatsApp IA conversacional (deshabilitada y Mock por defecto en QA)
# ---------------------------------------------------------------------------
# NO cambiar a true ni a proveedor externo sin autorización expresa de Santiago.
WHATSAPP_AI_ENABLED=false
WHATSAPP_AI_PROVIDER=Mock
WHATSAPP_AI_MODEL=mock-deterministic-v1
WHATSAPP_AI_API_KEY=
WHATSAPP_AI_BASE_URL=
WHATSAPP_AI_TIMEOUT_SECONDS=10
WHATSAPP_AI_MAX_OUTPUT_TOKENS=350
WHATSAPP_AI_MAX_BOT_OUTBOX_AGE_MINUTES=15
