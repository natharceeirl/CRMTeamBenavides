# Configuración de Caddy exclusiva para el entorno QA independiente.
# - El dominio entra obligatoriamente por la variable de entorno DOMINIO (sin valores inventados).
# - Obtiene certificado TLS válido vía Let's Encrypt cuando el DNS de QA apunta al servidor.
# - Impide indexación en buscadores con X-Robots-Tag: noindex, nofollow.
# - No aplica Basic Auth global para no interferir con los endpoints de la API ni con el
#   webhook público /api/whatsapp/webhook cuando se autorice la prueba con Meta Sandbox.

{$DOMINIO} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age={$HSTS_SEGUNDOS:0}"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@paginas not path /assets/* /api/*
	header @paginas Cache-Control "no-cache"
}
