# Copiar como .env, junto a este archivo, y completar. El .env no se sube al repositorio.

# Dominio público. Caddy pide el certificado a Let's Encrypt: el DNS tiene que apuntar
# al servidor y los puertos 80 y 443 estar abiertos. Para ensayar en una PC: localhost.
DOMINIO=app.teambenavides.com

# Durante cuántos segundos el navegador solo entra por HTTPS a este dominio (HSTS).
# Un año en producción; 0 al ensayar en una PC.
HSTS_SEGUNDOS=31536000

# Puertos del servidor. En una PC donde ya están en uso, por ejemplo 8080 y 8443.
PUERTO_HTTP=80
PUERTO_HTTPS=443

# Base de datos. Solo la ve la API, por la red interna.
POSTGRES_DB=crm_teambenavides
POSTGRES_USER=crm
# Generar con: openssl rand -hex 32
POSTGRES_PASSWORD=

# Firma de los tokens de sesión. Generar con: openssl rand -hex 48
JWT_SECRET_KEY=

# Copia diaria de la base, a esta hora de Perú, y cuántos días se guardan las copias.
HORA_RESPALDO=03:00
RETENCION_DIAS=14

# Red interna de Docker. La API acepta X-Forwarded-* solo desde ella, es decir, de Caddy.
# Cambiarla solo si choca con otra red del servidor.
RED_INTERNA=172.30.0.0/24

# Avisos al teléfono: Registro (solo se anotan en el log) o Firebase. Con Firebase,
# el JSON de la cuenta de servicio en una sola línea y entre comillas simples.
NOTIFICACIONES_PROVEEDOR=Registro
FIREBASE_CREDENCIALES_JSON=

# Integración Yamaha Motor del Perú (v3) - Servicios de datos (Ventas, Stock, Taller).
# Permanece en false hasta tener credenciales y autorización para enviar.
YAMAHA_ENABLED=false
# Código asignado por Yamaha al punto de venta y datos comerciales (obligatorio 3S).
YAMAHA_CODIGO_PUNTO_VENTA=20455687765_1
YAMAHA_NOMBRE_COMERCIAL_PUNTO_VENTA=Team Benavides
YAMAHA_TIPO_PUNTO_VENTA=3S
# Endpoints HTTP POST oficiales de Azure Functions v3.
YAMAHA_VENTAS_ENDPOINT_URL=https://yamaha-data-api-gwcjcgabesdzc8fw.brazilsouth-01.azurewebsites.net/api/ReceiveRetailVentas
YAMAHA_STOCK_ENDPOINT_URL=https://yamaha-data-api-gwcjcgabesdzc8fw.brazilsouth-01.azurewebsites.net/api/ReceiveRetailStock
YAMAHA_SERVICIO_TECNICO_ENDPOINT_URL=https://yamaha-data-api-gwcjcgabesdzc8fw.brazilsouth-01.azurewebsites.net/api/ReceiveRetailServicioTecnico
# Function Key compartida de Azure Functions (secreto: no incluir en el repositorio).
YAMAHA_FUNCTION_KEY=
# Function Keys por servicio (opcionales; si están vacías, se usa YAMAHA_FUNCTION_KEY).
YAMAHA_VENTAS_FUNCTION_KEY=
YAMAHA_STOCK_FUNCTION_KEY=
YAMAHA_SERVICIO_TECNICO_FUNCTION_KEY=
# Hora local de Perú para el envío diario de Stock al cierre de operaciones (HH:mm).
YAMAHA_HORA_CIERRE_STOCK_PERU=22:00
YAMAHA_HORA_LIMITE_RECUPERACION_STOCK_PERU=08:00
